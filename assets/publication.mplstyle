font.family: sans-serif
font.sans-serif: Arial, Helvetica, DejaVu Sans
font.size: 8
axes.titlesize: 9
axes.labelsize: 8
xtick.labelsize: 7
ytick.labelsize: 7
legend.fontsize: 7
figure.titlesize: 9
axes.linewidth: 0.8
axes.spines.top: False
axes.spines.right: False
axes.edgecolor: "#333333"
axes.labelcolor: "#111111"
xtick.color: "#333333"
ytick.color: "#333333"
xtick.major.width: 0.8
ytick.major.width: 0.8
xtick.major.size: 3
ytick.major.size: 3
lines.linewidth: 1.4
lines.markersize: 4
patch.linewidth: 0.8
legend.frameon: False
grid.color: "#D9D9D9"
grid.linewidth: 0.5
grid.alpha: 0.55
figure.facecolor: white
axes.facecolor: white
savefig.dpi: 600
savefig.bbox: tight
savefig.pad_inches: 0.02
pdf.fonttype: 42
ps.fonttype: 42
